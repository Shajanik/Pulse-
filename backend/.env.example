# Copy this file to .env for local development. Never commit real values.

# MongoDB Atlas (or local mongod) connection string.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pulse

# Redis Cloud (or local redis-server) connection string.
REDIS_URL=redis://localhost:6379

# Long, random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the Go server listens on.
PORT=8080

# Comma-separated list of origins allowed to call the API / open the
# WebSocket (your Vercel frontend URL in production).
ALLOWED_ORIGINS=http://localhost:5173
